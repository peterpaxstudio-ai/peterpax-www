---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  altPath: string;
}
const { title, description, lang, altPath } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(altPath, Astro.site);
const plUrl = lang === 'pl' ? canonical : alt;
const enUrl = lang === 'en' ? canonical : alt;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pl" href={plUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={plUrl} />
    <link rel="icon" type="image/png" href="/symbol.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@400;500;700&display=swap" />
  </head>
  <body>
    <Header lang={lang} altPath={altPath} />
    <main class="wrap" id="top"><slot /></main>
    <Footer />
  </body>
</html>
