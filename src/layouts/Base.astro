---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import firma from '../data/firma.json';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  altPath: string;
  ogType?: 'website' | 'article';
}
const { title, description, lang, altPath, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(altPath, Astro.site);
const plUrl = lang === 'pl' ? canonical : alt;
const enUrl = lang === 'en' ? canonical : alt;

// Dane organizacji dla wyszukiwarek i modeli AI (encja firmy, wspólna dla wszystkich stron).
const site = Astro.site!.origin;
const [street, city] = firma.adres.split(',').map((s: string) => s.trim());
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: firma.marka,
  legalName: firma.nazwa,
  url: site,
  logo: `${site}/logo-light.png`,
  email: firma.email,
  telephone: firma.telefon,
  taxID: firma.nip,
  address: { '@type': 'PostalAddress', streetAddress: street, addressLocality: city, addressCountry: 'PL' },
  founder: { '@type': 'Person', '@id': `${site}/#piotr-gancarz`, name: firma.wlasciciel, sameAs: [firma.linkedin] },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pl" href={plUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={plUrl} />
    <link rel="icon" type="image/png" href="/symbol.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_GB'} />
    <meta property="og:site_name" content={firma.marka} />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@400;500;700&display=swap" />
  </head>
  <body>
    <Header lang={lang} altPath={altPath} />
    <main class="wrap" id="top"><slot /></main>
    <Footer />
  </body>
</html>
